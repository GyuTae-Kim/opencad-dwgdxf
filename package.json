{
  "name": "opencad-dwgdxf",
  "version": "0.1.0",
  "private": true,
  "description": "서버 없이 브라우저에서 DXF·DWG 도면을 열고 그리고 고쳐 저장하는 2D CAD (OpenCAD)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run check:seo && npm run check:i18n",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:oracle": "vite-node scripts/oracle/require.ts && vitest run",
    "test:watch": "vitest",
    "check:seo": "opencad-site check-seo",
    "update:content-dates": "vite build && opencad-site update-content-dates",
    "test:seo": "opencad-site test-seo",
    "check:i18n": "opencad-site check-i18n",
    "test:i18n": "vitest run tests/i18n.test.ts",
    "sweep": "vite-node scripts/sweep/cli.ts sweep",
    "sweep:compare": "vite-node scripts/sweep/cli.ts compare"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "22.1.0",
    "opencad-site-kit": "github:GyuTae-Kim/opencad-site-kit#v0.1.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "earcut": "^3.2.4",
    "opentype.js": "^2.0.0",
    "pdfjs-dist": "6.3.289"
  }
}
