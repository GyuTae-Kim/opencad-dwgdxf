{
  "name": "OpenCAD DWG·DXF CAD",
  "short_name": "OpenCAD DWG",
  "description": "Kostenloses 2D-CAD zum Öffnen, Messen, Bearbeiten und Speichern von DWG/DXF-Zeichnungen im Browser ohne Installation. Zeichnungsdateien werden nicht an einen Server gesendet.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./",
  "scope": "../",
  "display": "standalone",
  "theme_color": "#252a33",
  "background_color": "#252a33",
  "categories": [
    "productivity",
    "utilities"
  ],
  "icons": [
    {
      "src": "../icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "file",
          "accept": [
            ".dwg",
            ".dxf",
            "image/vnd.dwg",
            "image/vnd.dxf",
            "application/acad",
            "application/x-dwg",
            "application/dxf",
            "application/x-dxf",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dxf": [
          ".dxf"
        ],
        "application/x-autocad-script": [
          ".scr"
        ],
        "application/x-autolisp": [
          ".lsp",
          ".mnl"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}
